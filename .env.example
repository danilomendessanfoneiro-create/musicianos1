# Modelo das variáveis de ambiente. Copie este arquivo para .env.local e
# preencha com os valores do SEU projeto Supabase.
#
#   cp .env.example .env.local
#
# Onde achar: Supabase > seu projeto > Project Settings > API
#
# O .env.local é ignorado pelo git (veja .gitignore) — nunca suba suas chaves.
# Sem estas variáveis o app roda em "modo local", guardando tudo no navegador.

SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA
